{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Dependencies Schema",
  "description": "Schema for defining dependencies in a DevContainer feature.",
  "type": "object",
  "properties": {
    "packages": {
      "type": "array",
      "description": "List of packages to install.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the package.",
            "examples": [
              "git",
              "curl",
              "nodejs"
            ]
          },
          "version": {
            "type": "string",
            "description": "The version of the package.",
            "pattern": "^(\\d+:)?[0-9]+(\\.[0-9]+)*(\\-[a-zA-Z0-9]+)?(-[0-9]+)?$",
            "examples": [
              "1.0.0",
              "2.3.4-beta",
              "2:1.24.1-2",
              "1:2.0.0",
              "3.1.4-1"
            ]
          },
          "versioningType": {
            "type": "string",
            "description": "The type of versioning used by the package.",
            "enum": [
              "semver",
              "archlinux",
              "custom"
            ],
            "examples": [
              "semver",
              "archlinux",
              "custom"
            ]
          },
          "description": {
            "type": "string",
            "description": "A short description of the package (optional)."
          },
          "archlinuxSource": {
            "type": "string",
            "description": "The Arch Linux source URL for the package (optional).",
            "format": "uri",
            "examples": [
              "https://archlinux.org/packages/extra/x86_64/git/"
            ]
          },
          "checkLatestCommand": {
            "type": "string",
            "description": "Command to check the latest version of the package (optional).",
            "examples": [
              "curl -sL https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json | jq -r '.version'"
            ]
          }
        },
        "required": [
          "name",
          "version",
          "versioningType"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "versioningType": {
                  "const": "archlinux"
                }
              }
            },
            "then": {
              "properties": {
                "archlinuxSource": {
                  "type": "string"
                }
              },
              "required": [
                "archlinuxSource"
              ]
            },
            "else": {
              "properties": {
                "versioningType": {
                  "enum": [
                    "semver",
                    "custom"
                  ]
                },
                "checkLatestCommand": {
                  "type": "string"
                },
                "archlinuxSource": {
                  "type": "null"
                }
              },
              "required": [
                "checkLatestCommand"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "packages"
  ],
  "minProperties": 1,
  "additionalProperties": false
}