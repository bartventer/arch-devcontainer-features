{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Dependencies Schema",
  "description": "Schema for defining dependencies in a DevContainer feature.",
  "type": "object",
  "properties": {
    "packages": {
      "type": "array",
      "description": "List of packages to install.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the package.",
            "examples": [
              "git",
              "curl",
              "nodejs"
            ]
          },
          "version": {
            "type": "string",
            "description": "The version of the package.",
            "pattern": "^(\\d+-)?[0-9]+(\\.[0-9]+)*(\\-[a-zA-Z0-9]+)?(-[0-9]+)?$",
            "examples": [
              "1.0.0",
              "2.3.4-beta",
              "2-1.24.1-2",
              "1-2.0.0",
              "3.1.4-1"
            ]
          },
          "versionScheme": {
            "type": "string",
            "description": "The version scheme of the package.",
            "enum": [
              "semver",
              "archlinux",
              "custom"
            ],
            "examples": [
              "semver",
              "archlinux",
              "custom"
            ]
          },
          "checkLatestCommand": {
            "type": "string",
            "description": "Command to check the latest version of the package (optional).",
            "examples": [
              "curl -sL https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json | jq -r '.version'"
            ]
          }
        },
        "required": [
          "name",
          "version",
          "versionScheme"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "versionScheme": {
                  "const": "archlinux"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "checkLatestCommand"
                ]
              }
            },
            "else": {
              "required": [
                "checkLatestCommand"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "packages"
  ],
  "minProperties": 1,
  "additionalProperties": false
}