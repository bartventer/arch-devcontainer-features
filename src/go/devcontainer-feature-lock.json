{
  "packages": [
    {
      "name": "go",
      "version": "1.25.5",
      "versionScheme": "semver",
      "checkLatestCommand": "curl -sL https://go.dev/VERSION?m=text | tr -d 'go' | head -1"
    },
    {
      "name": "goreleaser",
      "version": "2.12.3-1",
      "versionScheme": "archlinux"
    },
    {
      "name": "gox",
      "version": "1.0.1-7",
      "versionScheme": "archlinux"
    },
    {
      "name": "ko",
      "version": "0.18.0-1",
      "versionScheme": "archlinux"
    },
    {
      "name": "yaegi",
      "version": "0.16.1-1",
      "versionScheme": "archlinux"
    },
    {
      "name": "golangci-lint",
      "version": "2.7.1",
      "versionScheme": "semver",
      "checkLatestCommand": "curl -sL https://api.github.com/repos/golangci/golangci-lint/releases/latest | jq -r '.tag_name | ltrimstr(\"v\")'"
    }
  ]
}
